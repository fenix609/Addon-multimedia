<?xml version="1.0" encoding="UTF-8"?>
<!-- Juego de Tronos: temporadas y episodios. Lo abre Series.xml (<folder name="Juego de Tronos" file="Juego de Tronos.xml"/>).
     Súbelo a la carpeta Código de GitHub con este mismo nombre: Juego de Tronos.xml

     ESTRUCTURA: <tree> (la serie) > <folder> (temporadas) > <item> (episodios).
       title y plot van en español; originaltitle conserva el título original en inglés.

     ENLACES (en cada <item>; pon el que tengas, o varios: Kodi te deja elegir el servidor):
       drive="..."      enlace de compartir completo o solo el ID del archivo (permiso "cualquiera con el enlace")
       mega="..."       https://mega.nz/file/ID#CLAVE   (archivos individuales)
       terabox="..."    https://www.terabox.com/s/...   (cookie 'ndus' en los ajustes del addon)
       vidoza="..."  gamovideo="..."   (necesitan el addon ResolveURL)
       <source name="Nombre" url="..."/>  dentro del <item>, para cualquier otro servidor (Streamtape, Voe, Mixdrop...)
       Si no hay ningún enlace, el episodio aparece pero avisa de que todavía no tiene.
       (Opcional) en los ajustes puedes poner una clave API de Google Drive: más fiable con archivos grandes.
       Escribe & como &amp; dentro de las URL.

     IMÁGENES (en el <tree> de la serie, en cada <folder> o <item>; todas son URL y opcionales):
       icon, thumb, poster, fanart="https://i.imgur.com/odeV6fY.jpg", banner, clearlogo.  Si falta fanart="https://i.imgur.com/odeV6fY.jpg", hereda el de la carpeta superior.

     INFORMACIÓN (opcional): plot, year, genre, studio, director, rating (0-10), duration (minutos),
       mpaa, premiered (AAAA-MM-DD), tagline, originaltitle.
       mediatype = season | episode; season="1" y episode="N" en cada episodio. -->
<tree name="La casa del dragón" mediatype="tvshow" fanart="https://i.imgur.com/PUE5NS8.jpg" thumb="https://i.imgur.com/0pIxzl9.png">
    <folder name="Temporada 3" mediatype="season" season="1" year="2011"
            plot="Primera temporada. Los Stark, los Lannister y los Targaryen entran en una lucha por el Trono de Hierro."
            icon="" thumb="https://i.imgur.com/0pIxzl9.png" poster="" fanart="https://i.imgur.com/gdckFAf.jpg">
        <item title="3x01 · Se acerca el invierno" season="1" episode="1" originaltitle="Winter Is Coming"
              drive="https://drive.google.com/file/d/1yadl1DHcLg_oaBk94QZYJDdrVmehk4-N/view?usp=sharing" plot="" duration="" icon="" thumb="" fanart=""/>
        <item title="3x02 · El camino real" season="1" episode="2" originaltitle="The Kingsroad"
              drive="https://drive.google.com/file/d/1OnSgIcJKHJ-Ad8URoiGENBP5U3mBoojA/view?usp=sharing" plot="" duration="" icon="" thumb="" fanart=""/>
        <item title="1x03 · Lord Nieve" season="1" episode="3" originaltitle="Lord Snow"
              drive="drive_link" plot="" duration="" icon="" thumb="" fanart=""/>
    </folder>
    
</tree>